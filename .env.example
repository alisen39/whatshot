# 服务端口
PORT=6688

# 允许的浏览器 Origin（英文逗号分隔；如确需公开跨域可设为 *，不会携带凭据）
ALLOWED_DOMAIN="https://whatshot.top,http://127.0.0.1:3000"

# Runtime environment (production disables local loopback route proxies)
ENVIRONMENT=""

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# 缓存时长（秒）
CACHE_TTL=1800
HOTLIST_CACHE_TTL=1800
NEWSFLASH_CACHE_TTL=300

# 请求超时（ 毫秒 ）
REQUEST_TIMEOUT=6000

# 是否输出日志
USE_LOG_FILE=true

# RSS Mode
RSS_MODE=false

# 聚合来源使用的 RSSHub 实例（逗号或空格分隔；留空时使用内置实例列表）
SOURCE_RSSHUB_BASE_URLS=""

# 站点代理配置（JSON 格式，key 为域名关键词，value 为代理地址）
ROUTE_PROXY='{}'
# 示例: ROUTE_PROXY='{"github.com":"http://127.0.0.1:7890","nytimes.com":"http://127.0.0.1:7890"}'
# ENVIRONMENT=production 时会忽略 localhost/127.0.0.1 代理
